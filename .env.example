# Example env values for docker-compose

# Printer configuration (optional)
# PRINTER_TYPE: EPSON or STAR (case-insensitive)
PRINTER_TYPE=EPSON

# PRINTER_INTERFACE: e.g. "usb", "tcp://192.168.0.50", "/dev/usb/lp0"
PRINTER_INTERFACE=usb

# Label width in millimeters (used to size the on-screen preview and print layout)
# Common values: 80 or 58
# Example: LABEL_WIDTH_MM=80
LABEL_WIDTH_MM=80

# Optional: OpenAI API key for cloud transcription and icon suggestions.
# Local speech recognition in Docker works without this key.
# You can copy this file to `.env` and fill in your key, or export
# OPENAI_API_KEY in your shell before running compose.
OPENAI_API_KEY=

# TypeSafe API token for Jev icon classification (runtime only; never a build argument).
JEV_API_KEY=
# Optional: model name from TypeSafe GET /v1/models. The alias follows their current Jev build.
JEV_MODEL=jev-latest

# Non-Docker development only: point these to your local whisper.cpp installation.
# Docker already includes both files at these paths.
# WHISPER_BINARY=/usr/local/bin/whisper-cli
# WHISPER_MODEL_PATH=/opt/whisper/ggml-base.bin
