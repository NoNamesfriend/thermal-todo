FROM python:3.12-slim-bookworm
RUN pip install --no-cache-dir 'torch==2.14.1+cpu' --index-url https://download.pytorch.org/whl/cpu \
    && pip install --no-cache-dir 'transformers==5.0.0' 'safetensors==0.8.0' 'numpy==2.3.5' 'psutil==7.2.2'
ENV HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 USE_TF=0 TOKENIZERS_PARALLELISM=false
COPY scripts/local-ai /bench
WORKDIR /bench
ENTRYPOINT ["python", "-u", "/bench/benchmark_julia.py"]
